# SPDX-License-Identifier: MPL-2.0
# RSR-compliant text and diff attributes for the current repository languages.

* text=auto eol=lf

# Rust and Julia source
*.rs text eol=lf diff=rust
*.jl text eol=lf

# Bun site tooling
*.js text eol=lf
*.mjs text eol=lf

# AffineScript source/scaffolds
*.affine text eol=lf

# Guix Scheme and configuration
*.scm text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf

# Documentation
*.md text eol=lf diff=markdown
*.adoc text eol=lf
*.txt text eol=lf

# Build/task files
Justfile text eol=lf
justfile text eol=lf
Cargo.lock text eol=lf -diff

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.woff2 binary
*.zip binary
*.gz binary
