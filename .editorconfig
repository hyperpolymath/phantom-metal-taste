# SPDX-License-Identifier: MPL-2.0
# Editor configuration for the current Rust / Julia / Bun / Guix toolchain.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.adoc]
trim_trailing_whitespace = false

[*.rs]
indent_size = 4

[*.jl]
indent_size = 4

[*.affine]
indent_size = 2

[*.{js,mjs,json,yml,yaml,toml,scm,sh}]
indent_size = 2

[Justfile]
indent_style = space
indent_size = 4
