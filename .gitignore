# SPDX-License-Identifier: MPL-2.0
# RSR-compliant .gitignore; keep the provisioning engine under /build/ tracked.

# OS & editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Build outputs
/target/
/_build/
/dist/
/out/
/_site/
/coverage/
htmlcov/

# Dependencies
/node_modules/
/vendor/
/deps/
/.elixir_ls/

# Rust
# Cargo.lock is intentionally tracked.

# Julia
*.jl.cov
*.jl.mem
/Manifest.toml

# Generic caches from external tooling; Python is not a project runtime.
__pycache__/
*.py[cod]
.venv/

# Ada/SPARK
*.ali
/obj/
/bin/

# Haskell
/.stack-work/
/dist-newstyle/

# Chapel
*.chpl.tmp.*

# Secrets
.env
.env.*
*.pem
*.key
*.secret
secrets/
credentials/
.ssh/
.aws/
.kube/
.docker/
token.*
secret.*
.npmrc
.netrc
.pypirc
*.token
*.p12
*.pfx
credentials.json

# Logs and temporary files
*.log
/logs/
/tmp/
*.tmp
*.bak
.cache/
