' The present repository workflow, not a target-state application diagram.
@startuml Current Repository and Publication Path

title Current implementation and static publication path

actor Developer
node "Repository checkout" {
  component "Rust core\n(src/core)" as Rust
  component "Julia package\n(src/PhantomAnalytics.jl)" as Julia
  component "Bun site builder\n(scripts/build-site.mjs)" as Bun
  component "AffineScript files\n(TODO scaffolds; not executed)" as Affine
  folder "site.json\nreviewed publish allowlist" as Allowlist
}

cloud "GitHub Actions" {
  component "Rust tests" as RustCI
  component "Julia tests" as JuliaCI
  component "Bun tests and\nreproducible site build" as BunCI
  folder "Pages artifact\n(allowlisted paths only)" as Artifact
}

cloud "GitHub Pages" as Pages

node "Optional local containers" {
  database "ArangoDB" as Arango
  database "Virtuoso" as Virtuoso
}

Developer --> Rust : build / test
Developer --> Julia : build / test / demo
Developer --> Bun : test / build
Allowlist --> Bun : copy only configured paths
Rust --> RustCI : CI test
Julia --> JuliaCI : CI test
Bun --> BunCI : CI build + hash gate
BunCI --> Artifact : upload _site
Artifact --> Pages : publish

note right of Affine
  No compiler/runtime gate yet;
  files are incomplete scaffolds.
end note

note bottom of Arango
  Optional compose services.
  No current source code connects.
end note
note bottom of Virtuoso
  Optional compose services.
  No current source code connects.
end note

@enduml
