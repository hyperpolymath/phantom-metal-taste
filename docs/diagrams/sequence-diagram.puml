' SPDX-License-Identifier: MPL-2.0
' The implemented local test flow; no application API/database sequence exists.
@startuml Local Test and Site Reproducibility Flow

title Current local validation sequence

actor Developer
participant "Justfile" as Just
participant "Cargo workspace" as Cargo
participant "Julia package" as Julia
participant "Bun tests" as BunTest
participant "Bun site builder" as Site
participant "Site hash check" as Hash

Developer -> Just: just test
activate Just
Just -> Cargo: cargo test --locked --all-targets
Cargo --> Just: pass / failure
Just -> Julia: Pkg.test()
Julia --> Just: pass / failure
Just -> BunTest: bun test
BunTest --> Just: pass / failure
Just --> Developer: combined test result
deactivate Just

Developer -> Just: just site-check
activate Just
Just -> Site: build allowlisted site
Site --> Just: output tree A
Just -> Site: rebuild allowlisted site
Site --> Just: output tree B
Just -> Hash: compare paths and SHA-256
Hash --> Just: reproducible / mismatch
Just --> Developer: site-check result
deactivate Just

note over Cargo, Site
  These are local library/tooling checks.
  They do not start a service or connect
  to the optional database containers.
end note

@enduml
